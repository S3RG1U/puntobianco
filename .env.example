# Local DBngin Postgres (trust auth, no password)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/puntobianco

# Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Password given to the demo users created by `pnpm db:seed` (local development only)
SEED_PASSWORD=PuntoBianco-dev-2026

# Telegram is opt-in. Add the bot to your future group and set its chat ID.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public application URL for links in Telegram alerts
APP_URL=

# Exact external browser origins; native/server clients do not require CORS.
API_ALLOWED_ORIGINS=
AUTH_TRUSTED_ORIGINS=
